# STAGING ENVIRONMENT
# À créer sur Supabase: https://supabase.com/dashboard/projects

# 1. Créez un nouveau projet Supabase nommé "passenger-manager-staging"
# 2. Une fois créé, allez dans Settings > API
# 3. Copiez ces valeurs:

NEXT_PUBLIC_SUPABASE_URL=https://[VOTRE-PROJET-ID].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[VOTRE-ANON-KEY]

# Instructions pour Vercel:
# 1. Allez dans votre projet Vercel > Settings > Environment Variables
# 2. Créez ces 2 variables avec les valeurs ci-dessus
# 3. Sélectionnez "Preview" comme environnement
# 4. Sauvegardez
